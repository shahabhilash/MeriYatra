{
  "manifest_version": 3,
  "name": "MeriYatra",
  "version": "1.0.0",
  "description": "Real-Time Public Transit Tracking",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open MeriYatra"
  },
  "permissions": [
    "geolocation"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.openstreetmap.org/*",
    "https://*.project-osrm.org/*"
  ]
}
